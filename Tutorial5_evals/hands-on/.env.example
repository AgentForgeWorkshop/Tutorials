# --- model provider (required for real runs) ---
OPENROUTER_API_KEY=

# Exact model IDs from https://openrouter.ai/models  (must support tool calling)
AGENT_MODEL=openai/gpt-5-mini
JUDGE_MODEL=openai/gpt-5.6-terra

# --- LangSmith tracing (optional for the harness, required for the LangSmith demo) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tutorial5-paper-triage-v2
