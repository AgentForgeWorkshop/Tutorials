# You do not need to edit this. Run: python setup_workshop.py
# To set things by hand, copy this file to .env and fill it in. Never commit .env.

# Folder with your PDF, .txt and .md files. Subfolders are included.
LIBRARY_PATH="/full/path/to/your/papers"

# Needed for review_online_literature and chat.py. The provider is detected from the key:
#   OpenRouter (sk-or-...), Google AI Studio (AIza...), Anthropic (sk-ant-...) or OpenAI (sk-...).
LLM_API_KEY=""

# Optional. Defaults: deepseek/deepseek-v4.1-flash (OpenRouter), gemini-3.5-flash (Google),
# claude-haiku-5-5 (Anthropic), gpt-6-luna (OpenAI).
# LLM_MODEL="anthropic/claude-sonnet-5.5"

# Optional: any other OpenAI-compatible server, for example a local model.
# LLM_BASE_URL="http://localhost:11434/v1"

# Optional and free: https://openalex.org/settings/api
OPENALEX_API_KEY=""
